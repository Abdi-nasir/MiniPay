# ============================================================
# Docker host ports
# ============================================================

POSTGRES_HOST_PORT=5433
KEYCLOAK_HOST_PORT=8081
MINIPAY_API_HOST_PORT=8080


# ============================================================
# PostgreSQL container configuration
# ============================================================

POSTGRES_DB=minipay
POSTGRES_USER=minipay
POSTGRES_PASSWORD=minipay_dev_password


# ============================================================
# REDIS container configuration
# ============================================================
ConnectionStrings__Redis=cache:6379

Caching__PaymentListExpirationSeconds=15
Caching__PaymentListLocalExpirationSeconds=5
Caching__MerchantExpirationSeconds=300
# ============================================================
# ASP.NET Core runtime
# ============================================================

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080


# ============================================================
# MiniPay database connection
#
# MiniPay runs inside Docker, so it must use:
#   host = payment_db
#   port = 5432
#
# Do not use localhost:5433 inside the API container.
# ============================================================

ConnectionStrings__DefaultConnection=Host=payment_db;Port=5432;Database=minipay;Username=minipay;Password=minipay_dev_password


# ============================================================
# Keycloak bootstrap administrator
# ============================================================

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-change-me


# ============================================================
# Values referenced from minipay-realm.json
# ============================================================

MINIPAY_MERCHANT_SECRET=merchant-demo-secret-change-me
MINIPAY_SETTLEMENT_SECRET=settlement-worker-secret-change-me


# ============================================================
# JWT authentication
#
# Issuer:
#   Public Keycloak address appearing in the JWT "iss" claim.
#
# MetadataAddress:
#   Internal Docker address used by the API to reach Keycloak.
# ============================================================

Authentication__Issuer=http://localhost:8081/realms/minipay
Authentication__MetadataAddress=http://keycloak:8080/realms/minipay/.well-known/openid-configuration
Authentication__Audience=minipay-api
Authentication__RequireHttpsMetadata=false


# ============================================================
# Webhook configuration
# ============================================================

Webhooks__SigningSecret=development-webhook-signing-secret-change-me
Webhooks__TimeoutSeconds=5
Webhooks__MaximumAttempts=5
Webhooks__InitialRetryDelaySeconds=5
Webhooks__PollIntervalSeconds=2
Webhooks__BatchSize=25


# ============================================================
# Settlement configuration
# ============================================================

Settlements__FeePercentage=2.0
Settlements__ProcessingDelayMilliseconds=500

# Rate limiting
RateLimiting__MerchantRead__PermitLimit=300
RateLimiting__MerchantRead__WindowSeconds=60

RateLimiting__MerchantWrite__PermitLimit=60
RateLimiting__MerchantWrite__WindowSeconds=60

RateLimiting__Settlement__PermitLimit=5
RateLimiting__Settlement__WindowSeconds=60

RateLimiting__Webhook__PermitLimit=120
RateLimiting__Webhook__WindowSeconds=60