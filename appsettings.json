{
   "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Webhooks": {
    "TimeoutSeconds": 10,
    "MaximumAttempts": 5,
    "InitialRetryDelaySeconds": 5,
    "PollIntervalSeconds": 5,
    "BatchSize": 25,
    "SigningSecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error",
      "Microsoft.Extensions.Hosting": "Information"
    }
  },
    "Settlements": {
    "FeePercentage": 2.0,
    "ProcessingDelayMilliseconds": 500
  },
    "Authentication": {
    "Authority": "",
    "Audience": "minipay-api",
    "RequireHttpsMetadata": true
  },
  "RateLimiting": {
    "MerchantRead": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "MerchantWrite": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Settlement": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Webhook": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
