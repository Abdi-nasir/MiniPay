{
  "realm": "minipay",
  "displayName": "MiniPay",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      {
        "name": "minipay-merchant",
        "description": "Merchant machine clients allowed to manage their own payments and refunds."
      },
      {
        "name": "minipay-admin",
        "description": "MiniPay administrators allowed to access administrative endpoints."
      },
      {
        "name": "minipay-settlement",
        "description": "Internal clients allowed to generate settlements."
      }
    ]
  },

  "clients": [
    {
      "clientId": "minipay-api",
      "name": "MiniPay Protected API",
      "description": "OAuth resource server representing the MiniPay API.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },

    {
      "clientId": "merchant-demo",
      "name": "Demo Merchant Machine Client",
      "description": "Development merchant using the client credentials flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MINIPAY_MERCHANT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,

      "protocolMappers": [
        {
          "name": "minipay-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "minipay-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "merchant_id",
            "claim.name": "merchant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        }
      ],

      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "service_account"
      ]
    },

    {
      "clientId": "minipay-settlement-worker",
      "name": "MiniPay Settlement Worker",
      "description": "Internal machine client allowed to generate settlements.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${MINIPAY_SETTLEMENT_SECRET}",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,

      "protocolMappers": [
        {
          "name": "minipay-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "minipay-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],

      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "service_account"
      ]
    },

    {
      "clientId": "minipay-admin-portal",
      "name": "MiniPay Administration Portal",
      "description": "Browser client used by MiniPay administrators.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },

      "protocolMappers": [
        {
          "name": "minipay-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "minipay-api",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],

      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    }
  ],

  "users": [
    {
      "username": "service-account-merchant-demo",
      "enabled": true,
      "serviceAccountClientId": "merchant-demo",
      "attributes": {
        "merchant_id": [
          "11111111-1111-1111-1111-111111111111"
        ]
      },
      "realmRoles": [
        "minipay-merchant"
      ]
    },

    {
      "username": "service-account-minipay-settlement-worker",
      "enabled": true,
      "serviceAccountClientId": "minipay-settlement-worker",
      "realmRoles": [
        "minipay-settlement"
      ]
    },

    {
      "username": "minipay-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "MiniPay",
      "lastName": "Administrator",
      "email": "admin@minipay.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "minipay-admin",
        "minipay-settlement"
      ]
    }
  ]
}